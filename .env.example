# Required after deploying contracts/src/ExactDraft.sol to the matching testnet.
NEXT_PUBLIC_EXACTDRAFT_CONTRACT_ADDRESS=
NEXT_PUBLIC_BOT_EXACTDRAFT_CONTRACT_ADDRESS=
# Deployment block is required for bounded agreement history reads.
NEXT_PUBLIC_EXACTDRAFT_DEPLOYMENT_BLOCK=
NEXT_PUBLIC_BOT_EXACTDRAFT_DEPLOYMENT_BLOCK=

# Used by the Foundry deployment script. Keep this private key out of source control.
EXACTDRAFT_DEPLOY_RPC_URL=https://rpc.bohr.life
EXACTDRAFT_DEPLOY_CHAIN_ID=968
EXACTDRAFT_DEPLOYER_PRIVATE_KEY=
